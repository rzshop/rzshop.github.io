<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#070b16">
<meta name="description" content="RZ Shop — katalog akun dan item game.">
<title>RZ Shop — Game Account Marketplace</title>
<link rel="stylesheet" href="style.css">
</head>
<body>
<div class="announcement"><span class="live-dot"></span> RZ SHOP MARKETPLACE <b>•</b> KATALOG MULTI-GAME <a href="#catalog">Jelajahi katalog →</a></div>
<header class="header">
  <a class="brand" href="#home"><img src="assets/rz-logo.png" alt="RZ"><span>RZ <b>SHOP</b><small>GAME MARKETPLACE</small></span></a>
  <nav id="mainNav"><a href="#home">Beranda</a><a href="#catalog">Katalog</a><a href="#premium">Premium</a><a href="#sold">Terjual</a><a href="#sell">Jual akun</a><a href="#faq">FAQ</a></nav>
  <div class="header-actions"><button class="cart-open" id="adminOpen">Admin</button><button class="small-icon" id="favoriteOpen" aria-label="Favorit">♡ <i id="favCount">0</i></button><button class="cart-open" id="cartOpen">Keranjang <b id="cartCount">0</b></button><button class="hamburger" id="hamburger" aria-label="Menu">☰</button></div>
</header>
<main id="home">
<section class="hero">
  <div class="hero-copy">
    <div class="kicker"><span class="live-dot"></span> TEMPAT PILIHAN PARA PLAYER</div>
    <h1>AKUN GAME<br><em>IMPIANMU.</em></h1>
    <p>Jelajahi berbagai pilihan akun game dari beberapa kategori favorit. Temukan koleksi yang sesuai dengan gaya bermain dan budget kamu.</p>
    <div class="hero-ctas"><a class="btn primary" href="#catalog">Cari akun <span>↗</span></a><a class="btn outline" href="#how">Cara kerja</a></div>
    <div class="quick-stats"><div><strong>05+</strong><small>Kategori game</small></div><div><strong>24/7</strong><small>Katalog online</small></div><div><strong>RZ</strong><small>Gaming store</small></div></div>
  </div>
  <div class="hero-visual"><div class="ring ring-a"></div><div class="ring ring-b"></div><div class="character"><img src="rz-character.png" alt="Maskot anime RZ Shop"></div><div class="float-card"><span>RZ PLAYER</span><b>LEVEL UP</b><small>YOUR COLLECTION</small></div><div class="glow-dot"></div></div>
</section>
<div class="ticker"><div>RZ SHOP　✦　FREE FIRE　✦　MOBILE LEGENDS　✦　ROBLOX　✦　PUBG MOBILE　✦　RZ SHOP　✦　</div></div>

<section class="intro-strip wrap">
  <div><span class="eyebrow">SELAMAT DATANG DI RZ SHOP</span><h2>Temukan akun game <em>favoritmu.</em></h2><p>Pilih game, atur filter, lalu lihat detail listing yang tersedia.</p></div>
  <div class="intro-search"><span>⌕</span><input id="globalSearch" placeholder="Cari game, skin, rank, atau nama akun..."><button id="searchGo">Cari</button></div>
</section>

<section class="wrap catalog-section" id="catalog">
 <div class="section-heading"><div><span class="eyebrow">MARKETPLACE RZ</span><h2>Katalog <em>akun game.</em></h2><p>Contoh listing untuk demo. Ganti dengan produk asli sebelum dipublikasikan.</p></div><span class="count" id="listingCount">0 listing</span></div>
 <div class="game-tabs" id="gameTabs">
  <button class="game-tab active" data-game="Semua"><span>✦</span> Semua game</button>
  <button class="game-tab" data-game="Free Fire"><span>🔥</span> Free Fire</button>
  <button class="game-tab" data-game="Mobile Legends"><span>⚔</span> Mobile Legends</button>
  <button class="game-tab" data-game="Roblox"><span>🧱</span> Roblox</button>
  <button class="game-tab" data-game="PUBG Mobile"><span>🎯</span> PUBG Mobile</button>
  <button class="game-tab" data-game="Lainnya"><span>🎮</span> Lainnya</button>
 </div>
 <div class="filterbar">
  <label class="search-field"><span>⌕</span><input id="catalogSearch" placeholder="Cari di katalog..."></label>
  <select id="priceFilter"><option value="all">Semua harga</option><option value="low">Di bawah Rp100 ribu</option><option value="mid">Rp100–500 ribu</option><option value="high">Rp500 ribu–1 juta</option><option value="top">Di atas Rp1 juta</option></select>
  <select id="sortFilter"><option value="featured">Urutan: unggulan</option><option value="low">Harga terendah</option><option value="high">Harga tertinggi</option><option value="new">Terbaru</option></select>
  <button class="reset" id="resetFilters">Reset</button>
 </div>
 <div class="chips"><span>Populer:</span><button data-keyword="sultan">Sultan</button><button data-keyword="skin">Banyak skin</button><button data-keyword="rare">Item rare</button><button data-keyword="murah">Budget hemat</button></div>
 <div class="listing-grid" id="listingGrid"></div><div class="empty" id="empty" hidden>Belum ada listing yang cocok. Coba ubah filter pencarian.</div>
</section>

<section class="wrap premium-section" id="premium">
 <div class="section-heading"><div><span class="eyebrow">KURASI RZ SHOP</span><h2>Pilihan <em>premium.</em></h2><p>Listing unggulan dengan koleksi dan detail spesial.</p></div><span class="premium-mark">✦ RZ SELECTED</span></div>
 <div class="premium-grid" id="premiumGrid"></div>
</section>

<section class="sold-section" id="sold"><div class="wrap">
 <div class="section-heading"><div><span class="eyebrow">UPDATE KATALOG</span><h2>Baru <em>terjual.</em></h2><p>Contoh tampilan riwayat listing. Bukan transaksi aktual.</p></div><span class="live-label"><i></i> DEMO DATA</span></div>
 <div class="sold-grid" id="soldGrid"></div>
</div></section>

<section class="budget-section wrap"><div class="budget-copy"><span class="eyebrow">TEMUKAN SESUAI KEBUTUHAN</span><h2>Pilih berdasarkan <em>budget.</em></h2><p>Mulai dari pilihan hemat hingga koleksi premium.</p></div><div class="budget-grid">
 <button data-budget="low"><small>STARTER</small><b>Di bawah 100K</b><span>Jelajahi →</span></button>
 <button data-budget="mid"><small>POPULAR</small><b>100K – 500K</b><span>Jelajahi →</span></button>
 <button data-budget="high"><small>ELITE</small><b>500K – 1 Juta</b><span>Jelajahi →</span></button>
 <button data-budget="top"><small>ULTIMATE</small><b>1 Juta+</b><span>Jelajahi →</span></button>
</div></section>

<section class="trust-section"><div class="wrap trust-layout">
 <div><span class="eyebrow">BELANJA DENGAN BIJAK</span><h2>Kenali detail<br><em>sebelum memilih.</em></h2><p>Periksa informasi listing, status kepemilikan, dan ketentuan game terkait sebelum mengambil keputusan.</p></div>
 <div class="trust-cards"><article><span>01</span><div><h3>Informasi transparan</h3><p>Detail produk, kategori, dan harga ditampilkan dalam kartu listing.</p></div></article><article><span>02</span><div><h3>Periksa aturan game</h3><p>Perpindahan atau jual beli akun dapat dibatasi oleh ketentuan masing-masing penerbit game.</p></div></article><article><span>03</span><div><h3>Jaga data pribadi</h3><p>Jangan pernah mengirim password, kode OTP, atau data pemulihan akun lewat formulir publik.</p></div></article></div>
</div></section>

<section class="how-section wrap" id="how"><div class="section-heading"><div><span class="eyebrow">PANDUAN RZ SHOP</span><h2>Alur yang <em>jelas.</em></h2></div></div><div class="steps"><article><b>01</b><h3>Pilih kategori</h3><p>Pilih game dan gunakan filter untuk menemukan listing.</p></article><article><b>02</b><h3>Baca detail</h3><p>Periksa spesifikasi, harga, dan keterangan listing.</p></article><article><b>03</b><h3>Periksa ketentuan</h3><p>Pastikan transaksi dan perpindahan akun diizinkan oleh aturan game.</p></article><article><b>04</b><h3>Hubungi pengelola</h3><p>Gunakan kontak resmi toko yang sudah kamu verifikasi.</p></article></div></section>

<section class="sell-section" id="sell"><div class="wrap sell-layout"><div><span class="eyebrow">PUNYA KOLEKSI?</span><h2>Ajukan listing<br><em>ke RZ Shop.</em></h2><p>Formulir demo untuk mengirim minat penayangan listing. Jangan masukkan password, OTP, email pemulihan, atau data rahasia.</p></div><form id="sellForm" class="sell-form"><label>Nama panggilan<input required maxlength="40" id="sellerName" placeholder="Nama kamu"></label><label>Game<select id="sellerGame"><option>Free Fire</option><option>Mobile Legends</option><option>Roblox</option><option>PUBG Mobile</option><option>Lainnya</option></select></label><label>Deskripsi singkat listing<textarea id="sellerDesc" required maxlength="500" placeholder="Contoh: rank, level, item umum (tanpa data login)"></textarea></label><button class="btn primary" type="submit">Kirim minat listing ↗</button><small>Demo lokal: formulir tidak mengirim data ke server.</small></form></div></section>

<section class="wrap faq-section" id="faq"><span class="eyebrow">PUSAT BANTUAN</span><h2>Pertanyaan <em>umum.</em></h2><div class="faq-list">
 <details><summary>Game apa saja yang ada di RZ Shop?</summary><p>Kategori contoh mencakup Free Fire, Mobile Legends, Roblox, PUBG Mobile, dan game lainnya.</p></details>
 <details><summary>Apakah listing yang tampil merupakan produk sungguhan?</summary><p>Versi awal ini menggunakan data demo. Ganti data contoh dengan listing yang benar dan sudah mendapat izin sebelum website dipublikasikan.</p></details>
 <details><summary>Apakah jual beli akun selalu diperbolehkan?</summary><p>Tidak selalu. Ketentuan berbeda untuk setiap game dan penerbit. Periksa aturan resmi game terlebih dahulu; pelanggaran dapat menyebabkan pembatasan akun.</p></details>
 <details><summary>Apakah saya perlu memberikan password atau OTP?</summary><p>Tidak. Jangan pernah membagikan password, OTP, kode pemulihan, atau akses email pribadi melalui formulir atau chat yang tidak terverifikasi.</p></details>
 <details><summary>Apakah checkout dan pembayaran sudah aktif?</summary><p>Belum. Ini template frontend. Pembayaran, akun pengguna, database, dan pengelolaan pesanan membutuhkan backend dan integrasi layanan yang aman.</p></details>
</div></section>
</main>
<footer><a class="brand" href="#home"><img src="assets/rz-logo.png" alt=""><span>RZ <b>SHOP</b><small>GAME MARKETPLACE</small></span></a><p>© <span id="year"></span> RZ Shop · Template katalog demo</p><a href="#home">Kembali ke atas ↑</a></footer>

<div class="shade" id="shade"></div><aside class="drawer" id="drawer"><div class="drawer-head"><h3 id="drawerTitle">Keranjang</h3><button id="drawerClose">×</button></div><div id="drawerBody"></div><div class="drawer-bottom" id="drawerBottom"></div></aside>
<div class="modal-back" id="modalBack"><div class="modal"><button class="modal-x" id="modalClose">×</button><div id="modalBody"></div></div></div><div class="toast" id="toast"></div>
<div class="modal-back" id="adminBack"><div class="modal admin-modal"><button class="modal-x" id="adminClose">×</button><div id="adminLogin"><span class="eyebrow">RZ SHOP CONTROL</span><h2>Login <em>admin.</em></h2><p>Masuk menggunakan akun Google yang UID-nya sudah terdaftar di koleksi admins.</p><button class="btn primary" id="googleAdminLogin" type="button">Masuk dengan Google</button><p class="admin-note" id="adminMessage">Akses hanya diberikan kepada UID yang memiliki role "admin" di Firestore.</p></div><div id="adminPanel" hidden><span class="eyebrow">PANEL PENGELOLAAN</span><h2>Kelola <em>produk.</em></h2><p id="adminWho"></p><form id="productForm" class="sell-form"><input type="hidden" id="productId"><label>Nama produk<input id="productName" required maxlength="100"></label><label>Game<select id="productGame"><option>Free Fire</option><option>Mobile Legends</option><option>Roblox</option><option>PUBG Mobile</option><option>Lainnya</option></select></label><label>Harga (angka rupiah)<input id="productPrice" type="number" min="0" required></label><label>Deskripsi<textarea id="productDesc" maxlength="500" required></textarea></label><label>URL gambar (opsional)<input id="productImage" type="url" placeholder="https://..."></label><label>Status<select id="productStatus"><option value="active">Aktif</option><option value="draft">Draft</option></select></label><button class="btn primary" type="submit">Simpan produk</button><button class="btn outline" id="productCancel" type="button">Batal edit</button></form><div class="admin-list-head"><b>Produk tersimpan</b><button class="btn outline" id="adminLogout" type="button">Keluar</button></div><div id="adminProducts"></div></div></div></div>
<script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore-compat.js"></script>
<script>
window.RZ_FIREBASE_CONFIG = {
  apiKey: "AIzaSyC1an_MMsK5VwpmHMrM4aiD8afpdKw_QK0",
  authDomain: "rz-shop-912bd.firebaseapp.com",
  projectId: "rz-shop-912bd",
  storageBucket: "rz-shop-912bd.firebasestorage.app",
  messagingSenderId: "936119804529",
  appId: "1:936119804529:web:106bdd90ccb52d5e9a31d0",
  measurementId: "G-N80142WSGL"
